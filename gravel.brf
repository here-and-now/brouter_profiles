# ============================================================
# Os' Gravel Profile 1.20
# Based on "quaelnix-gravel.brf"
# Updates: Rebuilt Surface Preference & Wet Weather Engine
# ============================================================

---context:global
assign validForBikes true

# ------------------------------------------------------------
# 1. ROUTING PREFERENCES (Dropdowns)
# ------------------------------------------------------------
assign surface_pref       = 0   # %surface_pref% | Surface Preference | [0=Mixed Gravel, 1=Prefer Paved, 2=Prefer Unpaved]
assign cycle_routes       = 1   # %cycle_routes% | Cycle Route Network | [0=Ignore, 1=Prefer, 2=Prefer + Local Networks]
assign elevation_strategy = 2   # %elevation_strategy% | Elevation Handling | [0=Ignore, 1=Avoid Hills, 2=Avoid Hills & Steep Inclines, 3=Seek Hills]

# ------------------------------------------------------------
# 2. ENVIRONMENT & AVOIDANCES (Dropdowns)
# ------------------------------------------------------------
assign env_forest    = 2   # %env_forest% | Forest Preference | [0=Neutral, 1=Slightly Prefer, 2=Strongly Prefer]
assign env_river     = 0   # %env_river% | River Preference | [0=Neutral, 1=Slightly Prefer, 2=Strongly Prefer]
assign avoid_traffic = 2   # %avoid_traffic% | Traffic Avoidance | [0=Neutral, 1=Avoid, 2=Strongly Avoid]
assign avoid_towns   = 2   # %avoid_towns% | Town Avoidance | [0=Neutral, 1=Avoid, 2=Strongly Avoid]
assign avoid_noise   = 2   # %avoid_noise% | Noise Avoidance | [0=Neutral, 1=Avoid, 2=Strongly Avoid]

# ------------------------------------------------------------
# 3. TOGGLES & PHYSICS
# ------------------------------------------------------------
assign assume_wet_conditions = false   # %assume_wet_conditions% | Assume wet/muddy conditions | boolean
assign totalMass             = 90      # %totalMass% | Mass (kg) of bike + biker | number
assign maxSpeed              = 35      # %maxSpeed% | Absolute max speed (km/h) | number
assign bikerPower            = 150     # %bikerPower% | Average power (W) by biker | number
assign S_C_x                 = 0.36    # %S_C_x% | Drag coefficient × reference area × ½ air density
assign C_r                   = 0.009   # %C_r% | Rolling resistance coefficient

# ------------------------------------------------------------
# Mappings
# ------------------------------------------------------------
assign prefer_paved_paths   = equal surface_pref 1
assign prefer_unpaved_paths = equal surface_pref 2
assign prefer_cycle_routes  = greater cycle_routes 0
assign include_lcn          = equal cycle_routes 2

assign consider_elevation   = greater elevation_strategy 0
assign avoid_steep_inclines = equal elevation_strategy 2
assign seek_hills           = equal elevation_strategy 3

# Turn instructions & core engine
assign turnInstructionRoundabouts = true
assign considerTurnRestrictions   = true
assign turnInstructionMode        = 4
assign processUnusedTags          = true
assign pass1coefficient           = 1.5
assign pass2coefficient           = 0

---context:way

# ============================================================
# ELEVATION HANDLING
# ============================================================
assign downhillcost 
    switch seek_hills 0.0 
    switch avoid_steep_inclines 80 
    switch consider_elevation 40 
    0.0

assign downhillcutoff 
    switch seek_hills 0.5 
    switch and not consider_elevation avoid_steep_inclines 8 
    1.5

assign uphillcost 
    switch seek_hills 0.0 
    switch avoid_steep_inclines 160 
    switch consider_elevation 80 
    0.0

assign uphillcutoff 
    switch seek_hills 0.5 
    switch and not consider_elevation avoid_steep_inclines 8 
    1.5

assign has_decent_surface surface=asphalt|concrete|paved|paving_stones|fine_gravel|compacted
assign bad_when_steep ( and highway=track|path not ( or tracktype=grade1|grade2 has_decent_surface ) )

# Apply extra penalty ONLY when avoiding hills
assign downhillcost  switch and bad_when_steep not seek_hills ( max 160 downhillcost ) downhillcost
assign downhillcutoff switch and bad_when_steep not seek_hills ( min 1.5 downhillcutoff ) downhillcutoff
assign uphillcost    switch and bad_when_steep not seek_hills ( max 80 uphillcost ) uphillcost
assign uphillcutoff  switch and bad_when_steep not seek_hills ( min 1.5 uphillcutoff ) uphillcutoff

# ============================================================
# BASE ROUTE LOGIC
# ============================================================
assign any_cycleway or cycleway=track|lane|shared_lane|shared
                    or and cycleway:right=track|lane|shared_lane reversedirection=
                       and cycleway:left=track|lane|shared_lane reversedirection=yes

assign any_cycleroute
    or route_bicycle_icn=yes
    or route_bicycle_ncn=yes
    or route_bicycle_rcn=yes
    switch include_lcn route_bicycle_lcn=yes 0

assign turncost switch junction=roundabout 15 65
assign is_main_road highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link
assign initialclassifier switch route=ferry 4 switch is_main_road 3 switch footway=crossing 2 1
assign initialcost switch route=ferry 10000 switch is_main_road 320 20

assign nobikeaccess switch bicycle= switch vehicle= access=no|private vehicle=no|private bicycle=no|private|dismount
assign nofootaccess switch foot= ( and access=no|private ( not bicycle=dismount ) ) foot=no|private

assign badoneway
    switch not reversedirection=yes oneway=-1
        switch oneway=yes|reversible not oneway:bicycle=no
                                        or junction=roundabout oneway:bicycle=yes

assign onewaypenalty
    switch or ( not badoneway ) ( or cycleway=opposite|opposite_lane|opposite_track oneway:bicycle=no ) 1
    switch not junction=roundabout 5
    20

# ============================================================
# SURFACE & WET CONDITIONS ENGINE (NEW)
# ============================================================
assign is_paved
    and not surface=ground|grass|dirt|earth|mud|clay|sand|pebblestone|gravel|fine_gravel|compacted
    or highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link
    or surface=asphalt|concrete|paved|paving_stones|sett|cobblestone|metal
    or highway=road|unclassified|residential|living_street|service
    or smoothness=excellent|good tracktype=grade1

assign base_smoothness
    switch smoothness=excellent|very_good|good 1.0
    switch smoothness=intermediate 1.3
    switch smoothness=bad 1.5
    switch smoothness=very_bad 3.0
    switch smoothness=horrible 8.0
    switch smoothness=very_horrible|impassable 100
    # cycleway:surface priority
    switch cycleway:surface=asphalt|concrete 1.1
    switch cycleway:surface=fine_gravel|compacted 1.2
    switch cycleway:surface=gravel 1.5
    switch cycleway:surface=unpaved 1.6
    # surface fallback
    switch surface=asphalt|concrete|paved 1.1
    switch surface=fine_gravel|compacted 1.2
    switch surface=gravel 1.5
    switch surface=unpaved 1.6
    switch surface=ground|grass|dirt|earth|mud|clay|sand 2.6
    # tracktype (only when highway=track)
    switch and highway=track tracktype=grade1 1.2
    switch and highway=track tracktype=grade2 1.4
    switch and highway=track tracktype=grade3 1.6
    switch and highway=track tracktype=grade4 2.6
    switch and highway=track tracktype=grade5 2.8
    # highway type fallback
    switch highway=primary|secondary|tertiary 1.0
    switch highway=unclassified|residential|service 1.1
    switch highway=cycleway 1.2
    1.6

assign smoothnesspenalty base_smoothness

assign wet_surface_multiplier
    switch not assume_wet_conditions 1.0
    switch surface=mud|clay 5.0
    switch surface=dirt|earth|ground|grass 3.0
    switch tracktype=grade4|grade5 2.5
    switch surface=sand 1.2
    switch surface=gravel|pebblestone 1.2
    switch surface=fine_gravel|compacted 1.1
    switch tracktype=grade2|grade3 1.2
    switch is_paved 1.0
    switch smoothness=bad|very_bad|horrible|very_horrible|impassable 1.4
    1.0

# ============================================================
# PREFERENCE ENGINE (NON-COMPOUNDING)
# ============================================================
assign surface_preference_multiplier
    switch prefer_paved_paths
        switch is_paved 1.0 4.0      # 4x penalty for unpaved if paved preferred
    switch prefer_unpaved_paths
        switch is_paved 3.0 0.85     # 3x penalty for paved, slight reward for gravel
    1.0                              # Default (Mixed Gravel = 0)

# ============================================================
# PATH & HIGHWAY PENALTIES
# ============================================================
assign footwaypenalty
    switch bicycle=yes|designated
        switch segregated=yes 1.8 2.6
    switch not footway=sidewalk 3.2 4.9

assign cyclewaypenalty
    switch not foot=yes|designated 1.0
        switch segregated=yes 1.2 2.4

assign pathpenalty
    switch bicycle=yes|designated
        switch not foot=yes|designated 1.1
            switch segregated=yes 1.8 2.4
    switch foot=designated 4.9
    switch lesser smoothnesspenalty 1.6 1.1
    switch not and surface= smoothness= 3.0 4.9

assign stepspenalty
    switch ramp:stroller=yes 30
    switch ramp:bicycle=yes 65
    switch surface=paving_stones 80
    switch not assume_wet_conditions 400 600

assign tracktypepenalty
    switch tracktype=grade1 1.0
    switch tracktype=grade2 1.1
    switch tracktype=grade3 1.2
    switch tracktype=grade4 1.5
    switch tracktype=grade5 1.8
    switch highway=track 1.3
    1.0

assign hikingpenalty if sac_scale= then 1.0 else if sac_scale=hiking then 2.5 else 10000
assign mtbpenalty if mtb:scale= then 1.0 else if mtb:scale=0- then 1.0 else if mtb:scale=0 then 1.1 else if mtb:scale=0+ then 1.8 else if mtb:scale=1 then 4.0 else 10000

assign notcycleroutepenalty switch any_cycleroute 1.0 switch not prefer_cycle_routes 1.03 1.85
assign notcyclewaypenalty switch bicycle_road=yes 1.0 switch any_cycleway 1.02 1.06

assign maxspeedpenalty
    switch maxspeed=50 1.0
    switch maxspeed=60 1.1
    switch maxspeed=70 1.3
    switch maxspeed=80 1.4
    switch maxspeed=90 1.6
    switch maxspeed=100 1.8 switch highway=primary|secondary 1.8 1.0

# ------------------------------------------------------------
# Environment Penalties
# ------------------------------------------------------------
assign trafficpenalty_base
    switch estimated_traffic_class=1|2 1.1
    switch estimated_traffic_class=3 1.3
    switch estimated_traffic_class=4 2.0
    switch estimated_traffic_class=5 2.5
    switch estimated_traffic_class=6|7 3.0 1

assign actual_traffic_penalty
    switch equal avoid_traffic 0 1.0
    switch equal avoid_traffic 1 trafficpenalty_base
    multiply trafficpenalty_base 1.5

assign forest_factor_mod
    switch estimated_forest_class= 1.0 switch estimated_forest_class=1 0.9 switch estimated_forest_class=2 0.8
    switch estimated_forest_class=3 0.7 switch estimated_forest_class=4 0.6 switch estimated_forest_class=5 0.5
    switch estimated_forest_class=6 0.4 1

assign forest_factor_strong
    switch estimated_forest_class= 1.0 switch estimated_forest_class=1 0.85 switch estimated_forest_class=2 0.70
    switch estimated_forest_class=3 0.55 switch estimated_forest_class=4 0.45 switch estimated_forest_class=5 0.35
    switch estimated_forest_class=6 0.25 1

assign no_forest_penalty
    switch equal env_forest 0 1.0
    switch equal env_forest 1 forest_factor_mod
    forest_factor_strong

assign river_factor_mod
    switch estimated_river_class= 1.0 switch estimated_river_class=1 1.05 switch estimated_river_class=2 1.0
    switch estimated_river_class=3 0.95 switch estimated_river_class=4 0.85 switch estimated_river_class=5 0.75
    switch estimated_river_class=6 0.65 1

assign river_factor_strong
    switch estimated_river_class= 1.0 switch estimated_river_class=1 1.15 switch estimated_river_class=2 1.0
    switch estimated_river_class=3 0.85 switch estimated_river_class=4 0.65 switch estimated_river_class=5 0.50
    switch estimated_river_class=6 0.35 1

assign no_river_penalty
    switch equal env_river 0 1.0
    switch equal env_river 1 river_factor_mod
    river_factor_strong

assign town_factor_mod
    switch estimated_town_class= 1.0 switch estimated_town_class=1 1.2 switch estimated_town_class=2 1.5
    switch estimated_town_class=3 1.8 switch estimated_town_class=4 2.2 switch estimated_town_class=5 3.0
    switch estimated_town_class=6 3.5 1

assign town_factor_strong
    switch estimated_town_class= 1.0 switch estimated_town_class=1 1.5 switch estimated_town_class=2 2.0
    switch estimated_town_class=3 2.5 switch estimated_town_class=4 3.0 switch estimated_town_class=5 5.0
    switch estimated_town_class=6 6.0 1

assign no_town_penalty
    switch equal avoid_towns 0 1.0
    switch equal avoid_towns 1 town_factor_mod
    town_factor_strong

assign noise_factor_mod
    switch estimated_noise_class= 1.0 switch estimated_noise_class=1 1.2 switch estimated_noise_class=2 1.5
    switch estimated_noise_class=3 1.8 switch estimated_noise_class=4 2.2 switch estimated_noise_class=5 3.0
    switch estimated_noise_class=6 3.5 1

assign noise_factor_strong
    switch estimated_noise_class= 1.0 switch estimated_noise_class=1 1.5 switch estimated_noise_class=2 2.0
    switch estimated_noise_class=3 2.5 switch estimated_noise_class=4 3.0 switch estimated_noise_class=5 5.0
    switch estimated_noise_class=6 6.0 1

assign no_noise_penalty
    switch equal avoid_noise 0 1.0
    switch equal avoid_noise 1 noise_factor_mod
    noise_factor_strong

# ============================================================
# FINAL COST FACTOR
# ============================================================
assign costfactor
    multiply notcycleroutepenalty 
    multiply notcyclewaypenalty
    multiply surface_preference_multiplier
    multiply wet_surface_multiplier
    multiply actual_traffic_penalty
    multiply no_forest_penalty
    multiply no_river_penalty
    multiply no_town_penalty
    multiply no_noise_penalty
    multiply onewaypenalty 
    multiply smoothnesspenalty
    multiply hikingpenalty 
    multiply mtbpenalty
    multiply switch bicycle=use_sidepath 1.6 1
    multiply switch nobikeaccess 6 1
    multiply switch informal=yes switch prefer_unpaved_paths 1.0 1.2 1
    multiply tracktypepenalty
    multiply maxspeedpenalty
    switch or highway=motorway|motorway_link motorroad=yes 10000
    switch and nobikeaccess nofootaccess 10000
    switch highway= switch not route=ferry 10000 2
    switch highway=trunk|trunk_link switch any_cycleroute 20 80
    switch highway=bridleway|raceway switch not bicycle=yes 20 5
    switch highway=pedestrian switch not bicycle=yes 8 3
    switch highway=primary|primary_link 4.8
    switch highway=secondary|secondary_link 4.2
    switch highway=tertiary|tertiary_link 3.6
    switch highway=corridor 3.2
    switch highway=road 2.8
    switch highway=unclassified switch not any_cycleroute 2.6 1.4
    switch highway=living_street 2.5
    switch highway=service switch service= 2.4 3.0
    switch highway=residential switch not maxspeed=30 2.2 1.8
    switch highway=track 1.0
    switch highway=path pathpenalty
    switch highway=steps stepspenalty
    switch highway=footway footwaypenalty
    switch highway=cycleway cyclewaypenalty
    10000

# ============================================================
# PRIORITY CLASSIFIER (for voice hints)
# ============================================================
assign priorityclassifier =
  if ( highway=motorway ) then 30
  else if ( highway=motorway_link ) then 29
  else if ( highway=trunk ) then 28
  else if ( highway=trunk_link ) then 27
  else if ( highway=primary ) then 23
  else if ( highway=primary_link ) then 23
  else if ( highway=secondary ) then 22
  else if ( highway=secondary_link ) then 22
  else if ( highway=tertiary ) then 21
  else if ( highway=tertiary_link ) then 21
  else if ( highway=residential|living_street ) then 15
  else if ( highway=unclassified ) then 8
  else if ( highway=service ) then 8
  else if ( highway=cycleway ) then 8
  else if ( bicycle=designated ) then 8
  else if ( highway=track|road|path )
       then if or surface=asphalt|paved|concrete|wood|metal tracktype=grade1 then 8 else 6
  else if ( highway=steps ) then 2
  else if ( highway=pedestrian ) then 2
  else 0

assign isbadoneway   = not equal onewaypenalty 0
assign isgoodoneway  = if reversedirection=yes then oneway=-1 else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout  = junction=roundabout
assign islinktype    = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign isgoodforcars = if greater priorityclassifier 6 then true else if highway=residential|living_street|service then true else if ( and highway=track tracktype=grade1 ) then true else false

assign classifiermask
    add multiply isgoodoneway 2
    add multiply isroundabout 4
    add multiply islinktype 8
        multiply isgoodforcars 16

---context:node
assign nobikeaccess switch bicycle= switch vehicle= access=no|private vehicle=no|private bicycle=no|private|dismount
assign nofootaccess switch foot= ( and access=no|private ( not bicycle=dismount ) ) foot=no|private

assign barrierpenalty
    switch barrier= 0
    switch barrier=block|bollard 25
    switch barrier=gate|swing_gate 50
    switch barrier=cycle_barrier 87
    139

assign fordpenalty 
    switch ford=yes|stepping_stones
        switch assume_wet_conditions 500 50 
    0

assign initialcost
    add barrierpenalty
    add fordpenalty
    switch and nobikeaccess nofootaccess 1000000
    switch railway=level_crossing 300
    switch nobikeaccess 200
    switch railway=crossing 35
    switch not traffic_calming= 25
    switch highway=traffic_signals|crossing 20
    0