# ============================================================
# Os' Road Bike Profile 2.0 - "The Roadie's Delight"
# Rebuilt for: Surface Preference Control & Strict Tarmac Bias
# ============================================================

---context:global
assign validForBikes true

# ------------------------------------------------------------
# 1. ROUTING PREFERENCES
# ------------------------------------------------------------
assign surface_quality_pref = 0   # %surface_quality_pref% | Surface Quality | [0=Pavement Perfectionist, 1=Standard Road Bike, 2=Inclusive Paved]
assign cycle_routes         = 0   # %cycle_routes% | Cycle Route Network | [0=Ignore, 1=Prefer, 2=Prefer + Local]
assign elevation_strategy   = 0   # %elevation_strategy% | Elevation Handling | [0=Ignore, 1=Avoid Hills, 2=Avoid Hills/Steep]

# ------------------------------------------------------------
# 2. ENVIRONMENT & AVOIDANCES
# ------------------------------------------------------------
assign env_forest    = 1   # %env_forest% | Forest Preference | [0=Neutral, 1=Slightly Prefer, 2=Strongly Prefer]
assign env_river     = 1   # %env_river% | River Preference | [0=Neutral, 1=Slightly Prefer, 2=Strongly Prefer]
assign avoid_traffic = 2   # %avoid_traffic% | Traffic Avoidance | [0=Neutral, 1=Avoid, 2=Strongly Avoid]
assign avoid_towns   = 1   # %avoid_towns% | Town Avoidance | [0=Neutral, 1=Avoid, 2=Strongly Avoid]
assign avoid_noise   = 1   # %avoid_noise% | Noise Avoidance | [0=Neutral, 1=Avoid, 2=Strongly Avoid]

# ------------------------------------------------------------
# 3. PHYSICS
# ------------------------------------------------------------
assign totalMass             = 85      # Mass (kg) bike+biker
assign maxSpeed              = 55      # Max speed
assign bikerPower            = 180     # Watts
assign C_r                   = 0.0035  # Low rolling resistance (Road tires)

---context:way

# ============================================================
# SURFACE QUALITY ENGINE (REBUILT & PATCHED)
# ============================================================
# 0 = Strict (Only excellent/smooth tarmac)
# 1 = Standard (Good tarmac, heavily penalizes blocks/stones)
# 2 = Inclusive (Anything paved, mild penalties for rougher paths)

# Disqualify terrible smoothness immediately (intermediate removed from bad list)
assign bad_smoothness 
    smoothness=bad|very_bad|horrible|very_horrible|impassable

# Assume standard roads are paved if the surface tag is missing
assign is_assumed_paved 
    and surface= 
    highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|unclassified|residential|cycleway

# Perfect Tarmac (Safe for high-speed skinny tires)
assign is_perfect_asphalt 
    switch bad_smoothness 0 
    or surface=asphalt|concrete
    or smoothness=excellent|very_good|good
    is_assumed_paved

# Good Pavement (Generic paved or grade1 tracks with missing surface tags)
assign is_good_pavement
    switch bad_smoothness 0
    or is_perfect_asphalt
    or surface=paved
    and tracktype=grade1 surface=

# Block Paving / Stones (Vibrates strongly, slows you down)
assign is_acceptable_paving
    surface=paving_stones|sett|cobblestone

# The Penalty Matrix (Corrected Fallback Multipliers)
assign surface_penalty
    switch equal surface_quality_pref 0
        switch is_perfect_asphalt 1.0 
        switch is_good_pavement 2.0 
        switch is_acceptable_paving 5.0 20.0  # 20.0 = Harshest penalty for unpaved in Strict
    switch equal surface_quality_pref 1
        switch is_perfect_asphalt 1.0 
        switch is_good_pavement 1.2 
        switch is_acceptable_paving 2.5 10.0  # 10.0 = Standard penalty for unpaved
    # Fallback for Inclusive (2)
    switch is_perfect_asphalt 1.0 
    switch is_good_pavement 1.1 
    switch is_acceptable_paving 1.5 5.0       # 5.0 = Mildest penalty for unpaved

# ============================================================
# ELEVATION & BASICS
# ============================================================
assign consider_elevation   = greater elevation_strategy 0
assign avoid_steep_inclines = equal elevation_strategy 2
assign seek_hills           = equal elevation_strategy 3

assign downhillcost switch seek_hills 0.0 switch avoid_steep_inclines 80 40
assign uphillcost   switch seek_hills 0.0 switch avoid_steep_inclines 160 80

assign any_cycleroute
    or route_bicycle_icn=yes
    or route_bicycle_ncn=yes
    or route_bicycle_rcn=yes
        switch equal cycle_routes 2 route_bicycle_lcn=yes 0

assign nobikeaccess switch bicycle= switch vehicle= access=no|private vehicle=no|private bicycle=no|private|dismount

# ============================================================
# SCENIC REWARDS (Environment)
# ============================================================
assign forest_factor switch equal env_forest 1 0.95 switch equal env_forest 2 0.9 1.0
assign river_factor  switch equal env_river 1 0.95 switch equal env_river 2 0.9 1.0
assign scenic_multiplier max 0.6 multiply forest_factor river_factor

# ============================================================
# PENALTY CATEGORIZATION
# ============================================================

# 1. Traffic/Noise (Additive Extra Penalties)
assign traffic_penalty switch equal avoid_traffic 2 2.5 switch equal avoid_traffic 1 1.5 1.0
assign noise_penalty   switch equal avoid_noise 2 1.8 switch equal avoid_noise 1 1.2 1.0

assign traffic_extra max 0.0 sub traffic_penalty 1.0
assign noise_extra   max 0.0 sub noise_penalty 1.0
assign env_stress add 1.0 add traffic_extra noise_extra

# 2. Surface Physics
assign surface_physics surface_penalty

# ============================================================
# FINAL COST FACTOR
# ============================================================
assign costfactor
    
    # 1. Apply Categorized Multipliers
    multiply scenic_multiplier
    multiply env_stress
    multiply surface_physics
    
    # 2. Hard Constraints (Access & Type)
    multiply switch bicycle=use_sidepath 1.5 1
    multiply switch nobikeaccess 50 1
    
    # 3. Highway Base Costs
    switch or highway=motorway|motorway_link motorroad=yes 10000
    switch highway=primary|primary_link 3.0
    switch highway=secondary|secondary_link 2.0
    switch highway=tertiary|tertiary_link 1.5
    switch highway=unclassified|residential 1.2
    switch highway=cycleway 1.0
    switch highway=track 5.0
    switch highway=path 20.0
    10000

---context:node
assign barrierpenalty switch barrier=block|bollard 20 switch barrier=cycle_barrier 80 150
assign fordpenalty 500
assign initialcost add barrierpenalty switch railway=crossing 50 0
